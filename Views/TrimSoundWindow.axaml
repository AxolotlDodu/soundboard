<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Soundboard.Views.TrimSoundWindow"
        Title="Ajuster le son"
        Width="480" Height="385"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#12141C">

    <Window.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7B8194" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5B8DEF" />
            <Setter Property="Foreground" Value="#0F1117" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6E9BF2" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E4E6ED" />
            <Setter Property="BorderBrush" Value="#2E3244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#232635" />
            <Setter Property="BorderBrush" Value="#2E3244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#F2F3F7" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="20" Spacing="16">

        <TextBlock Name="SoundNameText" FontSize="16" FontWeight="Bold" Foreground="#F2F3F7"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Spacing="6">
            <TextBlock Text="EXTRAIT (GLISSER LES POIGNÉES)" Classes="section-label" />
            <Border Background="#0F1117" CornerRadius="6" ClipToBounds="True">
                <Canvas Name="WaveformCanvas" Height="100" Background="Transparent"
                        PointerPressed="OnWaveformPointerPressed"
                        PointerMoved="OnWaveformPointerMoved"
                        PointerReleased="OnWaveformPointerReleased" />
            </Border>
            <Grid ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0" Name="StartLabel" Foreground="#7B8194" FontSize="12" />
                <TextBlock Grid.Column="1" Name="EndLabel" Foreground="#7B8194" FontSize="12"
                           HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <Button Name="PreviewButton" Content="▶ Écouter l'extrait" Classes="secondary" HorizontalAlignment="Left" />

        <!-- Nom utilisé si l'extrait est enregistré comme nouveau son
             plutôt que d'écraser le trim du son d'origine. -->
        <StackPanel Spacing="6">
            <TextBlock Text="NOM DE LA COPIE (SI ENREGISTRÉ COMME NOUVEAU SON)" Classes="section-label"
                       TextWrapping="Wrap" />
            <TextBox Name="NewSoundNameTextBox" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Name="CancelButton" Content="Annuler" Classes="secondary" />
            <Button Grid.Column="2" Name="SaveAsNewButton" Content="Enregistrer comme nouveau son"
                    Classes="secondary" Margin="0,0,8,0" />
            <Button Grid.Column="3" Name="SaveButton" Content="Enregistrer" Classes="primary" />
        </Grid>

    </StackPanel>

</Window>
